CompileFlags:
  # Tell clangd where to find all headers so it resolves your symbols
  Add:
    - "-std=c++20"
    - "-IDaVinCpp2_0/libraries"
    - "-IDaVinCpp2_0/src/core"
    - "-IDaVinCpp2_0/src/core/window"
    - "-IDaVinCpp2_0/src/engine"
    - "-IDaVinCpp2_0/src/davscript"
    - "-IDaVinCpp2_0/src/utils"
    # Use compile_commands.json if available (generated by cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
  # compile_commands.json is symlinked at the project root
  CompilationDatabase: .

Diagnostics:
  # Suppress common false-positive warnings when compile_commands.json is missing
  Suppress:
    - "pp_file_not_found"

Index:
  Background: Build   # index the whole project in the background for full symbol search
